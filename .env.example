# =========================================================
# Belgravia & Co. — environment variables
# Copy to .env.local and fill in. NEVER commit real secrets.
# =========================================================

# --- Admin auth (static login for now) ---
# The single admin account used to sign in to /admin.
ADMIN_EMAIL=admin@superdrycleaners.co
ADMIN_PASSWORD=change-me-to-a-strong-password

# Secret used to sign the session cookie (HMAC).
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# --- Best-effort login abuse protection (process-local; not a distributed boundary) ---
# Optional positive integer overrides. Safe defaults apply when unset or invalid.
ADMIN_LOGIN_FAILURE_THRESHOLD=5
ADMIN_LOGIN_COOLDOWN_MS=900000
ADMIN_LOGIN_ENTRY_TTL_MS=3600000
ADMIN_LOGIN_MAX_KEYS=10000

# --- Supabase ---
# Create a project at supabase.com and get these from Settings → API.
SUPABASE_PROJECT_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE=your-service-role-key-here

# --- Email (Gmail SMTP) ---
# Enable 2-Step Verification on your Google account, then generate an App Password:
# myaccount.google.com → Security → 2-Step Verification → App passwords
SMTP_EMAIL=superdrycleaners@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ADMIN_NOTIFICATION_EMAIL=superdrycleaners@gmail.com
